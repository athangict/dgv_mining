<script>
$(document).ready(function() {
    let approvedDates = []; // store approved leave dates
    let formattedStartDate, formattedEndDate;

    const noOfDaysInput = $('#no_of_days');
    const submitButton = $('#submit_button');
    const remarks = $('#remarks');

    // 1️⃣ Fetch leave details and approved dates when employee changes
    $('#applicant').on('change', function() {
        const empId = $(this).val();

        if (!empId) return;

        // Fetch leave balances & approved dates
        $.post("<?php echo $this->url('leave', ['action' => 'getleavedtls']); ?>",
            { emp_id: empId },
            function(data) {
                console.log(data);
                approvedDates = data.approved_dates ? [...new Set(data.approved_dates)] : [];
                $('#region').val(data.empRegion);
                $('#loc').val(data.empLocation);

                // Populate leave balances
                data.leave.forEach(function(item) {
                    const row = $('input[name="leave_id[]"][value="'+item.id+'"]').closest('tr');
                    row.find('.tr_leave_used').val(item.used);
                    row.find('.tr_leave_bal').val(item.balance);
                });
            },
            'json'
        );
 
        // Load employee details
        $('#empdtl').load("<?php echo $this->url('leave', ['action' => 'displayempdtl']); ?>/" + empId, function() {
            $("#empdtl").trigger('chosen:updated');
        });
    });

    // Initialize datepickers
   /* $('#start_date, #end_date').datepicker({
        format: 'yyyy-mm-dd',
        autoclose: true
    });*/
		var serverDate = "<?php echo date('Y-m-d'); ?>";  // server's date

		$('#start_date, #end_date').datepicker({
			format: 'yyyy-mm-dd',
			autoclose: true,
			//startDate: new Date(new Date(serverDate).setDate(new Date(serverDate).getDate() - 10)),
		
		});

		$('#start_date, #end_date').datepicker('setDate', serverDate);

// Initialize default values
formattedStartDate = serverDate;
formattedEndDate   = serverDate;

// Initial calculation
validateLeave();

    $('#start_date, #end_date').on('changeDate', function () {

    formattedStartDate = formatDate($('#start_date').datepicker('getDate'));
    formattedEndDate   = formatDate($('#end_date').datepicker('getDate'));

    validateLeave();
});

    // Helper: format Date object as YYYY-MM-DD
    function formatDate(dateObj) {
        return dateObj.getFullYear() + '-' + 
               ('0' + (dateObj.getMonth() + 1)).slice(-2) + '-' +
               ('0' + dateObj.getDate()).slice(-2);
    }

    // Helper: generate all dates between two dates
    function getDateRange(start, end) {
        const arr = [];
        let dt = new Date(start);
        while (dt <= new Date(end)) {
            arr.push(dt.toISOString().slice(0,10));
            dt.setDate(dt.getDate() + 1);
        }
        return arr;
    }

    // Check for overlap with approved dates
    function checkLeaveDateOverlap() {
        if (!formattedStartDate || !formattedEndDate) return false;

        const selectedRange = getDateRange(formattedStartDate, formattedEndDate);
        const overlaps = selectedRange.filter(date => approvedDates.includes(date));

        if (overlaps.length > 0) {
            remarks.html("⚠️ Leave already approved on: <b>" + overlaps.join(", ") + "</b>. Please change the dates.")
                   .css("color", "red");
            submitButton.prop('disabled', true);
            return true;
        } else {
            remarks.text('').css("color", "");
            return false;
        }
    }

    // Fetch leave days considering holidays/weekends
	var region=$('#region').val();
    function updateNumberOfDays(callback) {
        if (!formattedStartDate || !formattedEndDate) return;

        const leaveType = parseInt($("#leave_type").val(), 10);
        console.log($('#region').val());
        let actionUrl;

        // Decide which endpoint to call based on leave type & region
        if ([2,3,5].includes(leaveType)) {
			
           actionUrl =  ($('#region').val()==2) 
                ? "<?php echo $this->url('leave', ['action'=>'getholidaysRegion']); ?>" 
               : "<?php  echo $this->url('leave', ['action'=>'getholidaysGpo']); ?>";
        } else {
			console.log('else');
            actionUrl = "<?php echo $this->url('leave', ['action'=>'getweekends']); ?>";
        }

        $.post(actionUrl,
            { start_date: formattedStartDate, end_date: formattedEndDate },
            function(data) {
                const days = parseFloat(data.non_holiday_days || 0);
                noOfDaysInput.val(days);

                if (formattedStartDate === formattedEndDate) {
                    //$('#no_of_days').closest('.form-group').hide();
                    $('#half_day').closest('.form-group').show();
					$('input[name="half"]').on('change', function() {
						console.log($('input[name="half"]:checked').val());
						var half=$('input[name="half"]:checked').val();
						if(half=='1'){
							noOfDaysInput.val(0.5);
						}
						else{
							noOfDaysInput.val(1);
						}
						
						
					});
                } else {
                   // $('#no_of_days').closest('.form-group').show();
                    $('#half_day').closest('.form-group').hide();
                }

                if (callback) callback(days);
            },
            'json'
        );
    }

    // 5️⃣ Validate leave: balance + overlap
   function validateLeave() {
    // 1️⃣ Check overlap first
    const hasOverlap = checkLeaveDateOverlap();
    if (hasOverlap) {
        // Stop here if overlap exists
        return;
    }

    // 2️⃣ If no overlap, calculate number of days and check balance
    updateNumberOfDays(function(days) {
        const leaveType = $("#leave_type").val();
        const row = $('input.tr_leave_id[value="' + leaveType + '"]').closest('tr');
        const balance = parseFloat(row.find('.tr_leave_bal').val()) || 0;

        if (days > balance) {
            submitButton.prop('disabled', true);
            remarks.text('⚠️ No. of leave days exceeds the balance.').css('color','red');
        } else {
            submitButton.prop('disabled', false);
            remarks.text(''); // safe to clear because no overlap
        }
    });
}
    // Trigger validation on leave type change
    $('#leave_type').on('change', validateLeave);

});
</script>