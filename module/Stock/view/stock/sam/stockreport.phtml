        $prefromdispatch = $this->dispatchObj->getPreSumfrom($row['location'], $row['item'], $data);

        $result = ($month == 10 && $year == 2023) ? $openingQty : ($openingQty - $pre_sale - $prefromdispatch + $pretodispatch);
        $closing = $result - $current_sale - $fromdispatch + $todispatch;
