<script>
const itemGroups = <?php echo json_encode($itemgroups); ?>;

document.getElementById('output_type').addEventListener('change', generateEditableRows);
document.getElementById('quantity').addEventListener('input', updateQuantitiesFromInputs);

const outputTypePercentages = {
    '40mm': { 1: 23, 2: 25, 3: 32, 5: 18, 8: 2 },
    '20mm': { 1: 37, 2: 43, 5: 18, 8: 2 },
    '30mm': { 1: 22, 2: 32, 4: 28, 5: 18 },
    'gsb':  { 9: 95 }
};

function generateEditableRows() {
    const outputType = document.getElementById('output_type').value;
    const feedQuantity = parseFloat(document.getElementById('quantity').value) || 0;
    const tableBody = document.querySelector('#item_fields tbody');
    tableBody.innerHTML = '';

    if (!outputType || !outputTypePercentages[outputType]) return;

    const percentages = outputTypePercentages[outputType];

    Object.entries(percentages).forEach(([itemId, percentage]) => {
        const item = itemGroups.find(item => item.id == itemId);
        if (item) {
            const quantity = ((percentage * feedQuantity) / 100).toFixed(2);
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>
                    <input class="form-control" type="text" name="product[]" value="${item.name}" readonly>
                    <input type="hidden" name="product_id[]" value="${item.id}">
                </td>
                <td>
                    <input class="form-control percent-input" type="number" name="product_percent[]" value="${percentage}" min="0" max="100" step="0.1" data-id="${itemId}">
                </td>
                <td>
                    <input class="form-control product_qty" type="text" name="product_qty[]" value="${quantity}" readonly>
                </td>
            `;
            tableBody.appendChild(row);
        }
    });

    document.querySelectorAll('.percent-input').forEach(input => {
        input.addEventListener('input', updateQuantitiesFromInputs);
    });
}

function updateQuantitiesFromInputs() {
    const feedQuantity = parseFloat(document.getElementById('quantity').value) || 0;
    const rows = document.querySelectorAll('#item_fields tbody tr');
    let totalPercentage = 0;

    rows.forEach(row => {
        const percentInput = row.querySelector('.percent-input');
        const qtyInput = row.querySelector('.product_qty');

        const percent = parseFloat(percentInput.value) || 0;
        totalPercentage += percent;

        const quantity = ((percent * feedQuantity) / 100).toFixed(2);
        qtyInput.value = quantity;
    });

    if (totalPercentage > 100) {
        alert("Total percentage cannot exceed 100%. Please adjust the values.");
        rows.forEach(row => row.querySelector('.percent-input').style.backgroundColor = '#FFCCCC');
    } else {
        rows.forEach(row => row.querySelector('.percent-input').style.backgroundColor = '');
    }
}

document.querySelector('#quantity').addEventListener('input', function () {
    const enteredQuantity = parseFloat(this.value) || 0;
    const stockQty = parseFloat(document.getElementById('stock_qty').value) || 0;

    if (enteredQuantity > stockQty) {
        alert('Entered quantity exceeds available stock!');
        this.value = stockQty;
        this.style.backgroundColor = '#FFCCCC';
    } else {
        this.style.backgroundColor = '';
    }
    updateQuantitiesFromInputs();
});

$('#date').datepicker();
</script>
