	function calculateTotal(element) {
		var row = element.closest('tr');  // Get the closest table row

		var rateInput = row.find('.tr_rate');  // Adjusted these to use class selectors and scope within the row
		var quantityInput = row.find('.tr_quantity');
		var amountInput = row.find('.tr_amount'); // Assuming there's a field for the total amount with the class "tr_amount"
		var totalInput = row.find('.tr_total');
		var gstrateInput = row.find('.tr_gst_rate');
		var gstamtInput = row.find('.tr_gst_amt');

		var rate = parseFloat(rateInput.val()) || 0;
		var quantity = parseFloat(quantityInput.val()) || 0;
		var gstrate = parseFloat(gstrateInput.val()) || 0;
		var amount = rate * quantity;
		var gstamt=(amount*gstrate)/100;
		var total=amount+gstamt;

		  // Assuming you want to show up to two decimal places
		amountInput.val(amount.toFixed(2)); 
		gstamtInput.val(gstamt.toFixed(2));
		totalInput.val(total.toFixed(2));
		calculateTotalAmount();
		calculateTotalNet();
	}
	function calculateTotalAmount() {
		console.log("calculateTotal amount");
		var total = 0.0;
		var grand = 0.0;
		var gst = 0.0;
		var discount = 0.0;
		var net=0;
		var discount_per = parseFloat($('#discount').val()) || 0;
		// Iterate over each amount input field in the table
		$('.tr_amount').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) { // Make sure it's a valid number
				total += amount;
			}
		});
		// Update the #total field with the new sum
		
		$('#tot_amount').val(total.toFixed(2));
		discount=total*(discount_per/100);
		net=total-discount;
		$('#discount_amt').val(discount.toFixed(2));
		$('#net_amount').val(net.toFixed(2));

		$('.tr_gst_amt').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) { // Make sure it's a valid number
				var dis=amount*(discount_per/100);
				gst += amount-dis;
			}
		});
		// Update the #total field with the new sum
		$('#tot_gst').val(gst.toFixed(2));

		$('.tr_total').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) { // Make sure it's a valid number
			var dis=amount*(discount_per/100);
				grand += amount-dis;
			}
		});
		// Update the #total field with the new sum
		$('#grand_tot').val(grand.toFixed(2));
	}		
