    <input type="hidden" name="target_id" id="target_id">

    <div class="modal-body">
        <div class="row">
           <div class="col-lg-12">
            <div class="form-group">
                <label for="year" class="control-label">Year</label>
                    <select class="form-control" name="year" id="year" required>
                        <?php
