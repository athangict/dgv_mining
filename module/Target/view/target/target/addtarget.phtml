    </div>
</form>

<script>
$(function () {
    // Initialize Chosen on all selects
    $('form select').chosen();

    // FormValidation initialization
    const fv = FormValidation.formValidation(document.getElementById('form'), {
        fields: {
            year: {
                validators: {
                    notEmpty: {
                        message: 'Please select a Year.'
                    }
                }
            },
            period: {
                validators: {
                    notEmpty: {
                        message: 'Please select a Period.'
                    }
                }
            },
            target: {
                validators: {
                    notEmpty: {
                        message: 'Please enter a Target.'
                    },
                    numeric: {
                        message: 'Target must be a number.'
                    }
                }
            },
            subperiod: {
                validators: {
                    callback: {
                        message: 'Please select a Sub Period.',
                        callback: function(input) {
                            // Validate only if subperiod is visible
                            const isVisible = $('#subp').is(':visible');
                            const value = input.value;
                            return !isVisible || (value !== '' && value !== '0');
                        }
                    }
                }
            }
        },
        plugins: {
            trigger: new FormValidation.plugins.Trigger(),
            bootstrap3: new FormValidation.plugins.Bootstrap3(),
            submitButton: new FormValidation.plugins.SubmitButton(),
            defaultSubmit: new FormValidation.plugins.DefaultSubmit()
        }
    }).on('core.element.validated', function (e) {
        const fieldName = e.field.replace('[]', '');
        const container = $('div#' + fieldName + '_chosen');

        if (e.valid) {
            container.removeClass('is-invalid').addClass('is-valid');
        } else {
            container.removeClass('is-valid').addClass('is-invalid');
        }
    });

    // Revalidate on Chosen change
    $('form select').change(function () {
        fv.revalidateField($(this).attr('name'));
    });

    // Handle Sub Period based on selected Period
    $('#period').on('change', function () {
        const periodId = $(this).val();
        if (periodId == 1 || periodId == 2) {
            $('#subp').show();
            $.post(
                "<?php echo $this->url('target', array('action' => 'getsubperiod')); ?>",
                { id: periodId },
                function (data) {
                    if (data && data.subperiod) {
                        $("#subperiod").html(data.subperiod);
                    } else {
                        $("#subperiod").html('<option value="0">None</option>');
                    }
                    $("#subperiod").trigger('chosen:updated');
                },
                'json'
            );
        } else {
            $('#subp').hide();
            $('#subperiod').val('0').trigger('chosen:updated');
        }
    });

    // Initialize chosen for subperiod on load
    $('#subperiod').chosen();
});
</script>
