<?php
$stepLabels = [
    1 => 'Assignment',
    2 => 'Attachments & Attendance',
    3 => 'Trips',
    4 => 'Overview'
];

$steps = [];
for ($i = 1; $i <= 4; $i++) {
    if ($i < $this->step) {
        $class = 'done';
        $number = '✔';
    } elseif ($i == $this->step) {
        $class = ($this->step == $this->maxstep) ? 'selected' : 'wait selected';
        $number = $i;
    } elseif ($i <= $this->maxstep) {
        $class = 'wait done';
        $number = $i;
    } else {
        $class = 'disabled';
        $number = $i;
    }

    $steps[] = [
        'class' => $class,
        'number' => $number,
        'label' => $stepLabels[$i],
        'url' => ($class == 'disabled') ? '#' : $this->url('q', ['action' => 'step' . $i, 'id' => $this->id])
    ];
}
?>

<!-- start: WIZARD STEPS -->
<div class="stepper-card">
    <div class="stepper">
        <ul class="stepper-list">
            <?php foreach ($steps as $step): ?>
                <li class="<?php echo $step['class']; ?>">
                    <a href="<?php echo $step['url']; ?>">
                        <div class="stepNumber"><?php echo $step['number']; ?></div>
                        <span class="stepDesc"><small><?php echo $step['label']; ?></small></span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
</div>