<script type="text/javascript">
$(function() {
    // Initialize Chosen dropdowns
    $('.chosen-widget').chosen({
        width: '100%',
        no_results_text: 'No match found!',
        placeholder_text_single: 'Select'
    });

    // AJAX load vehicles when company is selected
    $('#company').on('change', function() {
        var companyId = $(this).val();
        var applicationId = $('#application_id').val();

        $.post(
            "<?php echo $this->url('q', ['action' => 'getvehicles']); ?>",
            {
                comID: companyId,
                applicationId: applicationId
            },
            function(data) {
                $('#vehicle').html(data.vehicle); // Backend should return <option> elements
                $('#vehicle').trigger('chosen:updated'); // Refresh Chosen
            },
            'json'
        );
    });

    // Form Validation
    const fv = FormValidation.formValidation(document.getElementById('form'), {
        fields: {
            company: {
                validators: {
                    notEmpty: { message: 'Please select a company.' }
                }
            },
            vehicle: {
                validators: {
                    notEmpty: { message: 'Please select a vehicle.' }
                }
            },
            permit_no: {
                validators: {
                    notEmpty: { message: 'Please enter the permit number.' }
                }
            },
            aprox_weight: {
                validators: {
                    notEmpty: { message: 'Please enter the approximate weight.' }
                }
            }
        },
        plugins: {
            trigger: new FormValidation.plugins.Trigger(),
            bootstrap5: new FormValidation.plugins.Bootstrap5({
                rowSelector: '.mb-3'
            }),
            submitButton: new FormValidation.plugins.SubmitButton(),
            defaultSubmit: new FormValidation.plugins.DefaultSubmit()
        }
    });

    // Revalidate fields on change for Chosen dropdowns
    $('.chosen-widget').on('change', function() {
        fv.revalidateField($(this).attr('name'));
    });
});
</script>
