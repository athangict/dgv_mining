             <?php
$Total_target_3 = array();
$Total_actual_3 = array();
$year = date('Y');

foreach ($month as $m) {
    if (isset($m['period'], $m['id'])) {
        // Get revenue and cost targets
        $revenue_target = $this->targetObj->getColumn([
            'year' => $year,
            'period' => $m['period'],
            'type' => 2
        ], 'target');

        $cost_target = $this->targetObj->getColumn([
            'year' => $year,
            'period' => $m['period'],
            'type' => 3
        ], 'target');

        // Calculate target profit: Revenue - Cost
        $profit_target = floatval($revenue_target) - floatval($cost_target);
        array_push($Total_target_3, [
            "label" => $m['period'],
            "y" => $profit_target
        ]);

        // Get actual revenue and actual cost
        $revenue_actual = $this->salespObj->getActualTotalByMonth($year, $m['id'], 'rate');
        $cost_actual = $this->financeObj->getActualTotalByMonths($year, $m['id'], 'debit', ['head' => 18]);

        // Calculate actual profit: Revenue - Cost
        $profit_actual = floatval($revenue_actual) - floatval($cost_actual);
        array_push($Total_actual_3, [
            "label" => $m['period'],
            "y" => $profit_actual
        ]);
    }
}
