$Total_target = array();
$Total_actual = array();

if ($this->targetObj) {
    $year = date('Y');

    if ($period_id == 1) { 
        
        $quarter_months = [
            1 => [1, 2, 3],    
            2 => [4, 5, 6],    
            3 => [7, 8, 9],   
            4 => [10, 11, 12] 
        ];

        foreach ($quater as $q) {
            $quarter_id = $q['id'];
            $quarter_name = $q['name'];
            $monthly_ids = $quarter_months[$quarter_id] ?? [];

            $quarter_target = 0;
            foreach ($monthly_ids as $month_id) { $monthly_target = $this->targetObj->getColumn(['year' => $year,'period' => 2, 'status' => 4,'subperiod' => $month_id], 'target');
                $quarter_target += (float) $monthly_target;
            }
            $Total_target[] = ["label" => $quarter_name, "y" => $quarter_target];
            $actual_value = $this->groupObj->getSumQuaterly($year, $quarter_id, 'weight');
            $Total_actual[] = ["label" => $quarter_name, "y" => $actual_value];
        }

    } elseif ($period_id == 2) { 
        foreach ($month as $m) {
            if (isset($m['name'], $m['id'])) {
                $monthly_target = $this->targetObj->getColumn([ 'year' => $year,'period' => $period_id,'status' => 4,'subperiod' => $m['id'] ], 'target');

                $Total_target[] = ["label" => $m['name'], "y" => (float) $monthly_target];

                $actual_value = $this->groupObj->getActualTotalByMonth($year, $m['id'], 'weight');
                $Total_actual[] = ["label" => $m['name'], "y" => (float) $actual_value];
            }
        }
    }
}
